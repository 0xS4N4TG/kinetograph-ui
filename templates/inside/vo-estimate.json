"lines": [
{
"n": 1,
"text": "In 1893, Edison built the first film studio. The Black Maria. A black shed that turned to follow the sun.",
"start": 0.25,
"end": 5.734
},
{
"n": 2,
"text": "This is ours. Kinetograph Studio. It follows you.",
"start": 6.404,
"end": 8.992
},
{
"n": 3,
"text": "Ask for a chart, and the numbers tell a story.",
"start": 9.662,
"end": 12.042
},
{
"n": 4,
"text": "Ask for a place, and the camera dives in.",
"start": 12.712,
"end": 14.844
},
{
"n": 5,
"text": "A wall of your work. Your app, on every screen.",
"start": 15.514,
"end": 18.094
},
{
"n": 6,
"text": "Then plugins change the whole look.",
"start": 18.764,
"end": 20.392
},
{
"n": 7,
"text": "Hexed rolls a grade. Paper tears it out. VJ puts it on a screen. Brushes paint it by hand. And the words move with your voice.",
"start": 21.062,
"end": 28.034
},
{
"n": 8,
"text": "Talk to the agent. Mark the frame. Hear the cut. Tune every prop. Export.",
"start": 28.704,
"end": 32.924
},
{
"n": 9,
"text": "Still no browser. Every frame, straight on the GPU.",
"start": 33.594,
"end": 36.214
},
{
"n": 10,
"text": "Kinetograph zero point three. Motion pictures, written in code. Try it at kinetograph dot dev.",
"start": 36.884,
"end": 41.576
}
],
"duration": 44.246
}